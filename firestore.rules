rules_version = '2';

// Regole di sicurezza Firestore per Sotterranei e Dragoni.
// Da incollare in: Console Firebase > Firestore Database > Regole (oppure
// pubblicabili con "firebase deploy --only firestore:rules", vedi firebase.json).
// I test automatici di queste regole sono in test/regole (vedi il README lì).
//
// Premessa: la configurazione Firebase è pubblica (il repo è pubblico), quindi
// chiunque può parlare direttamente con il database saltando le pagine del sito.
// I controlli nel JavaScript delle pagine sono solo interfaccia: la sicurezza
// vera è tutta qui.
//
// Logica:
// - Registrazione aperta, ma con APPROVAZIONE: chi si registra crea il proprio
//   documento in "users" sempre come "player", livello 1, "approvato: false".
//   Finché l'admin non lo approva (e finché l'email non è verificata) può
//   leggere solo il proprio profilo: nessun altro dato della campagna.
//   I profili creati prima dell'introduzione dell'approvazione (senza il campo
//   "approvato") valgono come approvati.
// - Il proprietario di un profilo può modificare solo pochi campi tecnici
//   (email sincronizzata, flag di verifica, ordine dei pannelli) e può SOLO
//   consumare (-1) un credito "livelliDaSpendere", mai aggiungerne.
// - Solo un admin può modificare ruolo/approvazione/dati di un altro utente o
//   eliminare un account. Un DM può solo concedere livelli a un giocatore
//   (lo stesso aumento a "livello" e "livelliDaSpendere").
// - Profili utente (con le email) leggibili solo dal proprietario, dal DM e
//   dall'admin: i giocatori vedono gli altri solo tramite il riepilogo del
//   party (vedi "campagne/{id}/party").
// - "users/{uid}/notifiche": leggibili dal destinatario (o admin), create da
//   admin o da un DM verso un giocatore, segnabili come lette dal destinatario.
//   Ogni notifica parte anche come notifica push verso "users/{uid}/dispositivi"
//   (token dei dispositivi, gestiti solo dal proprietario).
// - "personaggi/{schedaId}": una scheda per documento, con "proprietarioUid" e
//   "campagnaId" (entrambi immutabili dopo la creazione). Sono ammessi solo i
//   campi noti di una scheda, con tipo e dimensione controllati. Leggibile per intero
//   solo dal proprietario, dal DM e dall'admin. Il livello di una scheda può
//   salire solo di 1 e solo spendendo, nella STESSA scrittura atomica, un
//   credito "livelliDaSpendere" del proprietario (concesso dal DM).
// - "campagne/{campagnaId}": DM proprietario ("dmUid", immutabile per il DM) e
//   membri ("membriUid"). Leggibile solo da DM, membri e admin. Se il titolo è
//   provvisorio, il campo pubblico "titolo" deve essere null: il titolo vero
//   vive in "campagne/{id}/privato/titolo", leggibile solo dal DM e dall'admin.
//   - "stato/{sessione|musica|riposo}": stato condiviso in tempo reale
//     (lettura: DM/membri/admin; scrittura: DM/admin). Nel riposo breve
//     avviato dal DM ogni giocatore invitato può solo segnare di aver finito.
//   - "party/{uid}": riepilogo pubblico della scheda attiva di ogni membro
//     (nome giocatore, personaggio, classe, livello, PF, condizioni,
//     esaurimento, dadi vita spesi, usi dei privilegi di classe, Carisma per
//     calcolarne i massimi, versione del ritratto). Le regole verificano che coincida con la scheda vera, quindi
//     non può essere falsificato.
//   - "immagini/{id}": libreria dei contenuti caricati dal DM (titolo,
//     descrizione, a chi è mostrato ora e nell'archivio di chi è); un membro
//     vede solo quelli in cui compare in "visibileA".
//   - "immaginiDM/{id}": note, tag, destinazione all'archivio e sessioni
//     collegate di ogni contenuto: solo DM e admin.
//   - "combattimento/stato", "combattenti/{id}": tracker di iniziativa
//     (round, turno, ordine), letti dai membri e gestiti dal DM; un giocatore
//     scrive solo l'iniziativa del proprio personaggio.
//   - "combattentiDM/{id}": PF dei nemici, solo DM e admin.
//   - "proposte/{id}": date proposte dal DM per la prossima sessione (calendario);
//     "proposte/{id}/risposte/{uid}": sì/forse/no di ogni membro, scritti
//     solo a proprio nome e solo finché la proposta è aperta.
// - "campagna/{docId}" (vecchio, pre-campagne): solo lettura per admin/DM, per
//   la migrazione una tantum. Rimovibile a migrazione confermata.
// - "registroSessioni/{sessioneId}": sessioni (programmata/in-corso/chiusa),
//   leggibili da DM e membri della loro campagna, gestite dal DM. Un DM può eliminare
//   solo le sessioni ancora "programmata"; l'admin qualsiasi.
//   - "appunti": log scritto da DM e membri della campagna, sempre a proprio
//     nome (nome verificato contro il profilo), max 2000 caratteri, solo
//     mentre la sessione è in corso ("tipo": "riposo" per le righe scritte
//     dai riposi, "tiro" per i lanci di dadi condivisi). Non modificabili;
//     eliminabili solo da DM/admin (moderazione).
//   - "tiriNascosti": i tiri che il DM tiene per sé, leggibili solo da DM e
//     admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funzioni di supporto ----------

    function isAutenticato() {
      return request.auth != null;
    }

    function percorsoUtente(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profiloCorrente() {
      return get(percorsoUtente(request.auth.uid)).data;
    }

    function ruoloUtente(uid) {
      return get(percorsoUtente(uid)).data.ruolo;
    }

    // Utente "del tavolo": autenticato, email verificata, con un profilo, e
    // approvato dall'admin (i profili senza il campo valgono come approvati).
    function isApprovato() {
      return isAutenticato()
        && request.auth.token.email_verified == true
        && exists(percorsoUtente(request.auth.uid))
        && profiloCorrente().get('approvato', true) == true;
    }

    function isAdmin() {
      return isApprovato() && profiloCorrente().ruolo == "admin";
    }

    function isDM() {
      return isApprovato() && profiloCorrente().ruolo == "dm";
    }

    function isDMoAdmin() {
      return isApprovato() && profiloCorrente().ruolo in ["dm", "admin"];
    }

    function campiModificati() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function testoValido(valore, minimo, massimo) {
      return valore is string && valore.size() >= minimo && valore.size() <= massimo;
    }

    function testoOpzionale(valore, massimo) {
      return valore == null || (valore is string && valore.size() <= massimo);
    }

    function datiCampagna(campagnaId) {
      return get(/databases/$(database)/documents/campagne/$(campagnaId)).data;
    }

    function datiCampagnaDopo(campagnaId) {
      return getAfter(/databases/$(database)/documents/campagne/$(campagnaId)).data;
    }

    // Il ruolo nella campagna non dipende dal profilo: si è DM solo della
    // campagna che si guida (dmUid). Un admin che gioca nella campagna di un
    // altro è un giocatore come gli altri: niente nemici nascosti, tiri
    // segreti o note del DM.
    function isDMdellaCampagna(campagnaId) {
      return isDMoAdmin() && datiCampagna(campagnaId).dmUid == request.auth.uid;
    }

    function isNellaCampagna(campagnaId) {
      return isApprovato() && (
        datiCampagna(campagnaId).dmUid == request.auth.uid ||
        request.auth.uid in datiCampagna(campagnaId).membriUid
      );
    }

    // ---------- Utenti ----------

    match /users/{uid} {
      allow get: if isAutenticato() && (request.auth.uid == uid || isDMoAdmin());

      // Elenco: solo admin (pannello utenti) e DM (gestione membri/party).
      allow list: if isDMoAdmin();

      // Creazione: solo il proprio documento, sempre come giocatore in attesa di
      // approvazione — nessuno può registrarsi direttamente come admin/DM.
      allow create: if isAutenticato() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['nome', 'email', 'ruolo', 'livello', 'livelliDaSpendere', 'emailVerificata', 'approvato', 'creatoIl'])
        && testoValido(request.resource.data.nome, 1, 60)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ruolo == "player"
        && request.resource.data.livello == 1
        && request.resource.data.livelliDaSpendere == 0
        && request.resource.data.emailVerificata == false
        && request.resource.data.approvato == false
        && request.resource.data.creatoIl == request.time;

      allow update: if isAutenticato() && (
        (request.auth.uid == uid && aggiornamentoProprioProfiloValido()) ||
        isAdmin() ||
        // Il DM concede livelli ai giocatori (anche a un admin che gioca).
        (isDM() && resource.data.ruolo in ["player", "admin"] && uid != request.auth.uid && passaggioLivelloDM())
      );

      allow delete: if isAdmin();

      function aggiornamentoProprioProfiloValido() {
        let campi = campiModificati();
        let dati = request.resource.data;
        return campi.hasOnly(['email', 'emailVerificata', 'ordinePannelli', 'livelliDaSpendere', 'preferenzeNotifiche'])
          && (!campi.hasAny(['preferenzeNotifiche']) || preferenzeNotificheValide(dati.preferenzeNotifiche))
          && (!campi.hasAny(['email']) || dati.email == request.auth.token.email)
          && (!campi.hasAny(['emailVerificata']) ||
              (dati.emailVerificata == true && request.auth.token.email_verified == true))
          && (!campi.hasAny(['ordinePannelli']) || dati.ordinePannelli is map)
          && (!campi.hasAny(['livelliDaSpendere']) ||
              (resource.data.livelliDaSpendere >= 1
                && dati.livelliDaSpendere == resource.data.livelliDaSpendere - 1));
      }

      // Preferenze delle push (pannello ⚙️ → Notifiche): tipi accesi o spenti,
      // fascia "non disturbare" e fuso orario del telefono.
      function preferenzeNotificheValide(p) {
        return p is map && p.keys().hasOnly(['tipi', 'silenzio', 'fuso'])
          && (!('tipi' in p) || (p.tipi is map && p.tipi.keys().hasOnly(['sessione', 'date', 'livello', 'turno'])))
          && (!('silenzio' in p) || (p.silenzio is map && p.silenzio.keys().hasOnly(['attivo', 'da', 'a'])
            && p.silenzio.get('attivo', false) is bool
            && p.silenzio.get('da', '') is string && p.silenzio.get('da', '').size() <= 5
            && p.silenzio.get('a', '') is string && p.silenzio.get('a', '').size() <= 5))
          && (!('fuso' in p) || (p.fuso is string && p.fuso.size() <= 64));
      }

      // Il DM concede uno o più livelli (es. il livello di partenza della
      // campagna): lo stesso aumento a entrambi i contatori, nient'altro.
      function passaggioLivelloDM() {
        let aumento = request.resource.data.livello - resource.data.get('livello', 0);
        return campiModificati().hasOnly(['livello', 'livelliDaSpendere'])
          && aumento >= 1 && aumento <= 19
          && request.resource.data.livelliDaSpendere == resource.data.get('livelliDaSpendere', 0) + aumento;
      }

      match /notifiche/{notificaId} {
        allow read: if isAutenticato() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin() || (isDM() && ruoloUtente(uid) in ["player", "admin"]);
        allow update: if isAutenticato() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta']);
        allow delete: if isAdmin();
      }

      // Dispositivi su cui ricevere le notifiche push (token di Firebase Cloud
      // Messaging): ognuno gestisce solo i propri. Li legge per inviare la
      // Cloud Function inviaNotificaPush, che toglie i token scaduti.
      match /dispositivi/{dispositivoId} {
        allow read, delete: if isAutenticato() && request.auth.uid == uid;
        allow create, update: if isApprovato() && request.auth.uid == uid
          && dispositivoId.size() <= 64
          && request.resource.data.keys().hasOnly(['token', 'piattaforma', 'aggiornatoIl'])
          && testoValido(request.resource.data.token, 1, 4096)
          && testoOpzionale(request.resource.data.get('piattaforma', null), 120)
          && request.resource.data.aggiornatoIl == request.time;
      }
    }

    // ---------- Eliminazione degli utenti ----------
    // L'admin chiede di eliminare un utente (non sé stesso) creando questo
    // documento: la Cloud Function eliminaUtente lo esegue e scrive l'esito.
    // Si può cancellare la richiesta (es. per riprovare dopo un errore).
    match /richiesteEliminazione/{uid} {
      allow get, list, delete: if isAdmin();
      allow create: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['richiestaDa', 'richiestaIl'])
        && request.resource.data.richiestaDa == request.auth.uid
        && request.resource.data.richiestaIl == request.time;
    }

    // ---------- Schede personaggio ----------

    match /personaggi/{schedaId} {
      allow get: if isApprovato() && (request.auth.uid == resource.data.proprietarioUid || isDMoAdmin());
      allow list: if isDMoAdmin() || (isApprovato() && request.auth.uid == resource.data.proprietarioUid);

      // Creazione: solo a proprio nome, a livello 1, in una campagna di cui si
      // fa parte (come membro o come DM).
      allow create: if isApprovato()
        && request.resource.data.proprietarioUid == request.auth.uid
        && request.resource.data.livello == 1
        && isNellaCampagna(request.resource.data.campagnaId)
        && campiSchedaValidi(request.resource.data.keys());

      allow update: if isAdmin()
        || (isApprovato() && request.auth.uid == resource.data.proprietarioUid && aggiornamentoSchedaValido())
        // Il DM della campagna aggiorna dalla pagina Sessione PF, condizioni ed
        // esaurimento (danni, cure, "prono"…) e ciò che cambia con un riposo
        // (dadi vita, slot, incantesimi di razza, tiri contro la morte, usi dei
        // privilegi di classe):
        // nient'altro della scheda.
        || (isDMdellaCampagna(resource.data.get('campagnaId', 'nessuna'))
          && campiModificati().hasOnly(['hp', 'condizioni', 'esaurimento', 'dadiVitaSpesi', 'slotIncantesimoUsati',
              'incantesimiRazzaUsati', 'tiriSalvezzaMorte', 'usiPrivilegi', 'aggiornatoIl'])
          && campiSchedaValidi(campiModificati()))
        // Migrazione dei dati pre-campagne: il DM può solo ASSEGNARE una
        // campagna a una scheda che non ne ha ancora una.
        || (isDM() && campiModificati().hasOnly(['campagnaId']) && !('campagnaId' in resource.data));

      allow delete: if isAdmin() || (isApprovato() && request.auth.uid == resource.data.proprietarioUid);

      function aggiornamentoSchedaValido() {
        let campi = campiModificati();
        return !campi.hasAny(['proprietarioUid', 'campagnaId', 'creataIl'])
          && campiSchedaValidi(campi)
          && (!campi.hasAny(['livello']) || passaggioLivelloGiocatore());
      }

      // Solo i campi noti di una scheda, ciascuno col tipo giusto e una
      // dimensione ragionevole (niente campi arbitrari né testi enormi). Si
      // controllano solo i campi scritti in questa operazione ("campi"), così
      // eventuali campi di schede molto vecchie non bloccano gli aggiornamenti.
      function campiSchedaValidi(campi) {
        let d = request.resource.data;
        return campi.hasOnly([
            'nome', 'razza', 'sottorazza', 'classe', 'livello', 'caratteristiche', 'hp', 'tiriSalvezzaMorte',
            'proprietarioUid', 'campagnaId', 'attiva', 'ordine', 'creataIl', 'aggiornatoIl',
            'inventario', 'allineamento', 'background', 'incantesimiConosciuti', 'incantesimiPreparati',
            'slotIncantesimoUsati', 'incantesimiRazzaUsati', 'armaturaIndossata', 'scudoIndossato',
            'abilitaCompetenti', 'personalita', 'competenzeLinguaggi', 'talenti', 'monete', 'ritratto',
            'condizioni', 'esaurimento', 'dadiVitaSpesi', 'usiPrivilegi'])
          && (!campi.hasAny(['condizioni']) || condizioniValide(d.condizioni))
          && (!campi.hasAny(['dadiVitaSpesi']) || interoTra(d.dadiVitaSpesi, 0, d.get('livello', 1)))
          && (!campi.hasAny(['usiPrivilegi']) || (d.usiPrivilegi is map && d.usiPrivilegi.size() <= 20))
          && (!campi.hasAny(['esaurimento']) || interoTra(d.esaurimento, 0, 6))
          && (!campi.hasAny(['nome']) || testoValido(d.nome, 1, 60))
          && (!campi.hasAny(['razza']) || testoOpzionale(d.razza, 40))
          && (!campi.hasAny(['sottorazza']) || testoOpzionale(d.sottorazza, 40))
          && (!campi.hasAny(['classe']) || testoOpzionale(d.classe, 40))
          && (!campi.hasAny(['livello']) || (d.livello is int && d.livello >= 1 && d.livello <= 20))
          && (!campi.hasAny(['caratteristiche']) || (d.caratteristiche is map && d.caratteristiche.keys().hasOnly(
              ['forza', 'destrezza', 'costituzione', 'intelligenza', 'saggezza', 'carisma'])))
          && (!campi.hasAny(['hp']) || (d.hp is map && d.hp.keys().hasOnly(['massimi', 'attuali', 'temporanei'])))
          && (!campi.hasAny(['tiriSalvezzaMorte']) || (d.tiriSalvezzaMorte is map
              && d.tiriSalvezzaMorte.keys().hasOnly(['successi', 'fallimenti'])))
          && (!campi.hasAny(['attiva']) || d.attiva is bool)
          && (!campi.hasAny(['ordine']) || (d.ordine is int && d.ordine >= 0 && d.ordine < 1000))
          && (!campi.hasAny(['inventario']) || (d.inventario is list && d.inventario.size() <= 200))
          && (!campi.hasAny(['allineamento']) || testoOpzionale(d.allineamento, 40))
          && (!campi.hasAny(['background']) || testoOpzionale(d.background, 100))
          && (!campi.hasAny(['incantesimiConosciuti']) || (d.incantesimiConosciuti is list && d.incantesimiConosciuti.size() <= 300))
          && (!campi.hasAny(['incantesimiPreparati']) || (d.incantesimiPreparati is list && d.incantesimiPreparati.size() <= 300))
          && (!campi.hasAny(['incantesimiRazzaUsati']) || (d.incantesimiRazzaUsati is list && d.incantesimiRazzaUsati.size() <= 50))
          && (!campi.hasAny(['slotIncantesimoUsati']) || (d.slotIncantesimoUsati is map && d.slotIncantesimoUsati.size() <= 12))
          && (!campi.hasAny(['armaturaIndossata']) || testoOpzionale(d.armaturaIndossata, 60))
          && (!campi.hasAny(['scudoIndossato']) || d.scudoIndossato is bool)
          && (!campi.hasAny(['abilitaCompetenti']) || (d.abilitaCompetenti is list && d.abilitaCompetenti.size() <= 30))
          && (!campi.hasAny(['personalita']) || personalitaValida(d.personalita))
          && (!campi.hasAny(['competenzeLinguaggi']) || testoOpzionale(d.competenzeLinguaggi, 2000))
          && (!campi.hasAny(['talenti']) || (d.talenti is list && d.talenti.size() <= 100))
          && (!campi.hasAny(['ritratto']) || d.ritratto == null || (d.ritratto is int && d.ritratto > 0))
          && (!campi.hasAny(['monete']) || (d.monete is map
              && d.monete.keys().hasOnly(['rame', 'argento', 'elettro', 'oro', 'platino'])));
      }

      function personalitaValida(p) {
        return p is map && p.keys().hasOnly(['tratti', 'ideali', 'legami', 'difetti'])
          && testoOpzionale(p.get('tratti', null), 2000)
          && testoOpzionale(p.get('ideali', null), 2000)
          && testoOpzionale(p.get('legami', null), 2000)
          && testoOpzionale(p.get('difetti', null), 2000);
      }

      // +1 livello solo consumando, nella stessa scrittura atomica (batch), un
      // credito "livelliDaSpendere" del proprietario.
      function passaggioLivelloGiocatore() {
        let utente = percorsoUtente(request.auth.uid);
        return request.resource.data.livello == resource.data.get('livello', 1) + 1
          && getAfter(utente).data.livelliDaSpendere == get(utente).data.livelliDaSpendere - 1;
      }
    }

    // ---------- Campagne ----------

    // Titolo provvisorio => il campo pubblico "titolo" deve restare vuoto.
    function titoloPubblicoCoerente() {
      return request.resource.data.get('titoloProvvisorio', false) != true
        || request.resource.data.get('titolo', null) == null;
    }

    match /campagne/{campagnaId} {
      allow get, list: if isApprovato() && (
        resource.data.dmUid == request.auth.uid || request.auth.uid in resource.data.membriUid
      );

      allow create: if titoloPubblicoCoerente()
        && isDMoAdmin() && request.resource.data.dmUid == request.auth.uid;

      allow update: if titoloPubblicoCoerente()
        && isDMoAdmin() && resource.data.dmUid == request.auth.uid
        && request.resource.data.dmUid == resource.data.dmUid;

      allow delete: if isAdmin();

      match /stato/{docId} {
        allow get: if isNellaCampagna(campagnaId);
        allow write: if isDMdellaCampagna(campagnaId)
          && (docId != "riposo" || riposoValido())
          && (docId != "tavola" || tavolaValida());
        // Riposo breve avviato dal DM: ogni giocatore invitato può solo
        // segnare di aver finito (aggiungersi a "conclusi").
        allow update: if docId == "riposo"
          && isApprovato()
          && request.auth.uid in datiCampagna(campagnaId).membriUid
          && request.auth.uid in resource.data.partecipanti
          && campiModificati().hasOnly(['conclusi'])
          && request.resource.data.conclusi.toSet() == resource.data.conclusi.toSet().union([request.auth.uid].toSet());
      }

      // Titolo vero della campagna (anche quando è ancora provvisorio).
      match /privato/{docId} {
        allow get: if isDMdellaCampagna(campagnaId);
        // getAfter: la campagna può nascere nella stessa scrittura atomica.
        allow write: if isDMoAdmin() && datiCampagnaDopo(campagnaId).dmUid == request.auth.uid;
      }

      // Libreria dei contenuti della campagna (mappe, luoghi, PNG, nemici,
      // oggetti, dispense). Il file è in Storage (campagne/{campagnaId}/{id}).
      // Qui i dati che un giocatore può vedere: titolo, descrizione, a chi è
      // mostrato ora durante la sessione ("mostrataA"), nell'archivio di chi è
      // ("archiviataPer"), a chi serve perché è la mappa in tavola
      // ("inTavolaPer"). "visibileA" è l'unione dei tre, verificata qui sotto:
      // un membro legge il documento (e scarica il file, vedi storage.rules)
      // solo se ci compare.
      match /immagini/{immagineId} {
        allow get, list: if isDMdellaCampagna(campagnaId) || (
          isApprovato()
          && request.auth.uid in datiCampagna(campagnaId).membriUid
          && request.auth.uid in resource.data.visibileA
        );
        allow create, update: if isDMdellaCampagna(campagnaId) && contenutoValido();
        allow delete: if isDMdellaCampagna(campagnaId);
      }

      // Dati riservati al DM per ogni contenuto: note, tag (possono contenere
      // spoiler), destinazione all'archivio e sessioni a cui è collegato.
      match /immaginiDM/{immagineId} {
        allow get, list, delete: if isDMdellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && contenutoDMValido();
      }

      // Combattimento: stato condiviso (round e turno) e combattenti, letti da
      // tutti i membri e gestiti dal DM. Un giocatore può solo scrivere
      // l'iniziativa (e il bonus per gli spareggi) del proprio personaggio.
      match /combattimento/{docId} {
        allow get: if isNellaCampagna(campagnaId);
        allow write: if isDMdellaCampagna(campagnaId) && docId == "stato" && statoCombattimentoValido();
      }

      match /combattenti/{combattenteId} {
        allow get, list: if isNellaCampagna(campagnaId);
        allow create: if isDMdellaCampagna(campagnaId) && combattenteValido();
        allow update: if (isDMdellaCampagna(campagnaId) && combattenteValido()) || (
          isApprovato()
          && resource.data.tipo == "pg"
          && resource.data.uid == request.auth.uid
          && request.auth.uid in datiCampagna(campagnaId).membriUid
          && campiModificati().hasOnly(['iniziativa', 'bonus'])
          && combattenteValido()
        );
        allow delete: if isDMdellaCampagna(campagnaId);
      }

      // Nemici non ancora rivelati: solo il DM. Quando li rivela passano in
      // "combattenti" (e i giocatori li vedono comparire nell'ordine).
      match /combattentiNascosti/{combattenteId} {
        allow get, list, delete: if isDMdellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && combattenteValido() && request.resource.data.tipo == 'nemico';
      }

      // PF dei nemici e note: solo il DM (i giocatori vedono solo "salute").
      match /combattentiDM/{combattenteId} {
        allow get, list, delete: if isDMdellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && combattenteDMValido();
      }

      // Calendario: il DM propone date (proposte), i membri rispondono per sé
      // (sì/forse/no per ogni data) finché la proposta è aperta; tutti i membri
      // vedono proposte e risposte.
      match /proposte/{propostaId} {
        allow get, list: if isNellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && propostaValida();
        allow delete: if isDMdellaCampagna(campagnaId);

        match /risposte/{uid} {
          allow get, list: if isNellaCampagna(campagnaId);
          allow create, update: if isApprovato()
            && request.auth.uid == uid
            && uid in datiCampagna(campagnaId).membriUid
            && rispostaValida()
            && get(/databases/$(database)/documents/campagne/$(campagnaId)/proposte/$(propostaId)).data.stato == "aperta";
          allow delete: if isDMdellaCampagna(campagnaId);
        }
      }

      // Bestiario: creature create dal DM (PNG, nemici, personaggi unici con
      // il loro stato). Solo il DM le legge e le scrive.
      match /bestiario/{creaturaId} {
        allow get, list, delete: if isDMdellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && creaturaValida();
      }

      // Mappe della sessione. "stato/tavola" dice quale mappa della Libreria è
      // in tavola (cosa inquadra lo schermo comune, se segue il turno); per
      // ogni mappa il DM salva la griglia (mappe/{immagineId}) e le pedine:
      // "pedine" quelle che vedono tutti (personaggi, con l'uid del giocatore
      // come ID, e nemici rivelati), "pedineDM" i nemici nascosti, solo per il
      // DM. I membri leggono solo la mappa in tavola; ogni giocatore muove solo
      // la propria pedina e solo su quella mappa.
      match /mappe/{immagineId} {
        allow get: if isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId);
        allow list, delete: if isDMdellaCampagna(campagnaId);
        allow create, update: if isDMdellaCampagna(campagnaId) && grigliaValida();

        match /pedine/{pedinaId} {
          allow get, list: if isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId);
          allow create, update: if pedinaValida(pedinaId) && (
            isDMdellaCampagna(campagnaId)
            || (pedinaId == request.auth.uid && request.resource.data.tipo == 'pg'
              && mappaInTavolaPerMembro(campagnaId, immagineId))
          );
          allow delete: if isDMdellaCampagna(campagnaId);
        }

        match /pedineDM/{pedinaId} {
          allow get, list, delete: if isDMdellaCampagna(campagnaId);
          allow create, update: if isDMdellaCampagna(campagnaId) && pedinaNemicoValida();
        }

        // Nebbia di guerra della mappa (un documento "stato"): la scrive il
        // DM, la leggono i membri quando la mappa è in tavola.
        match /nebbia/{docId} {
          allow get: if isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId);
          allow delete: if isDMdellaCampagna(campagnaId);
          allow create, update: if isDMdellaCampagna(campagnaId) && docId == 'stato' && nebbiaValida();
        }

        // Strumenti dal vivo (righello e ping): un documento per persona, che
        // scrive solo lei; li vedono il DM e i membri quando la mappa è in tavola.
        match /strumenti/{uid} {
          allow get, list: if isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId);
          allow create, update: if uid == request.auth.uid && strumentiValidi()
            && (isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId));
          allow delete: if isDMdellaCampagna(campagnaId) || uid == request.auth.uid;
        }

        // Aree degli incantesimi: le mette chiunque sia al tavolo (a proprio
        // nome), le toglie chi le ha messe o il DM.
        match /aree/{areaId} {
          allow get, list: if isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId);
          allow create: if areaValida()
            && (isDMdellaCampagna(campagnaId) || mappaInTavolaPerMembro(campagnaId, immagineId));
          allow delete: if isDMdellaCampagna(campagnaId)
            || (resource.data.autoreUid == request.auth.uid && isNellaCampagna(campagnaId));
        }
      }

      // Riepilogo pubblico della scheda attiva di un membro.
      match /party/{uid} {
        allow get, list: if isNellaCampagna(campagnaId);

        allow create, update: if riepilogoValido(campagnaId, uid) && (
          isDMdellaCampagna(campagnaId) ||
          (isApprovato() && request.auth.uid == uid && uid in datiCampagna(campagnaId).membriUid)
        );

        allow delete: if isDMdellaCampagna(campagnaId);
      }
    }

    function listaUid(valore) {
      return valore is list && valore.size() <= 30;
    }

    function propostaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titolo', 'note', 'opzioni', 'stato', 'creataIl', 'confermata'])
        && testoOpzionale(d.get('titolo', null), 80)
        && testoOpzionale(d.get('note', null), 500)
        && d.opzioni is list && d.opzioni.size() >= 1 && d.opzioni.size() <= 10
        && d.stato in ['aperta', 'confermata', 'annullata']
        && (d.get('confermata', null) == null || d.confermata is map);
    }

    function rispostaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'risposte', 'aggiornatoIl'])
        && d.nome == profiloCorrente().get('nome', null)
        && d.risposte is map && d.risposte.size() <= 10
        && d.aggiornatoIl == request.time;
    }

    function riposoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'attivo', 'partecipanti', 'conclusi', 'avviatoIl'])
        && d.tipo == "breve"
        && d.attivo is bool
        && listaUid(d.partecipanti)
        && listaUid(d.conclusi);
    }

    // Mappe della sessione (vedi match /mappe).
    function mappaInTavolaPerMembro(campagnaId, immagineId) {
      return isApprovato()
        && request.auth.uid in datiCampagna(campagnaId).membriUid
        && get(/databases/$(database)/documents/campagne/$(campagnaId)/stato/tavola).data.get('immagineId', null) == immagineId;
    }

    function numeroTra(valore, minimo, massimo) {
      return (valore is int || valore is float) && valore >= minimo && valore <= massimo;
    }

    function tavolaValida() {
      let d = request.resource.data;
      let q = d.get('inquadratura', null);
      return d.keys().hasOnly(['immagineId', 'inquadratura', 'segueTurno', 'aggiornatoIl'])
        && d.get('segueTurno', true) is bool
        && (d.immagineId == null || (d.immagineId is string && d.immagineId.size() <= 40))
        && (q == null || (q is map && q.keys().hasOnly(['x', 'y', 'w', 'h'])
          && numeroTra(q.x, -100000, 100000) && numeroTra(q.y, -100000, 100000)
          && numeroTra(q.w, 1, 100000) && numeroTra(q.h, 1, 100000)));
    }

    function grigliaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lato', 'ox', 'oy', 'visibile', 'snap', 'aggiornatoIl'])
        && numeroTra(d.lato, 4, 2000)
        && numeroTra(d.ox, 0, d.lato) && numeroTra(d.oy, 0, d.lato)
        && d.visibile is bool && d.snap is bool;
    }

    // Pedina di un personaggio (ID = uid del giocatore) o di un nemico.
    function pedinaValida(pedinaId) {
      let d = request.resource.data;
      return (d.tipo == 'pg'
          && d.keys().hasOnly(['tipo', 'uid', 'c', 'r', 'aggiornatoIl'])
          && d.uid == pedinaId
          && numeroTra(d.c, -50, 2000) && numeroTra(d.r, -50, 2000)
          && d.aggiornatoIl == request.time)
        || pedinaNemicoValida();
    }

    function pedinaNemicoValida() {
      let d = request.resource.data;
      return d.tipo == 'nemico'
        && d.keys().hasOnly(['tipo', 'nome', 'immagineId', 'taglia', 'salute', 'condizioni', 'c', 'r', 'alleato', 'aggiornatoIl'])
        && d.get('alleato', false) is bool
        && testoValido(d.nome, 1, 60)
        && (d.immagineId == null || (d.immagineId is string && d.immagineId.size() <= 40))
        && tagliaValida(d.taglia)
        && d.salute in ['illeso', 'ferito', 'grave', 'a terra']
        && condizioniValide(d.condizioni)
        && numeroTra(d.c, -50, 2000) && numeroTra(d.r, -50, 2000)
        && d.aggiornatoIl == request.time;
    }

    function nebbiaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['attiva', 'c0', 'r0', 'colonne', 'righe', 'celle', 'aggiornatoIl'])
        && d.attiva is bool
        && d.c0 in [-1, 0] && d.r0 in [-1, 0]
        && interoTra(d.colonne, 1, 500) && interoTra(d.righe, 1, 500)
        && d.celle is string && d.celle.size() <= 50000;
    }

    function mappaConCampi(p, campi) {
      return p is map && p.keys().hasOnly(campi) && p.keys().hasAll(campi);
    }

    function strumentiValidi() {
      let d = request.resource.data;
      let r = d.get('righello', null);
      let p = d.get('ping', null);
      return d.keys().hasOnly(['righello', 'ping', 'aggiornatoIl'])
        && d.aggiornatoIl == request.time
        && (r == null || (mappaConCampi(r, ['x1', 'y1', 'x2', 'y2'])
          && numeroTra(r.x1, -100000, 100000) && numeroTra(r.y1, -100000, 100000)
          && numeroTra(r.x2, -100000, 100000) && numeroTra(r.y2, -100000, 100000)))
        && (p == null || (mappaConCampi(p, ['x', 'y', 'n'])
          && numeroTra(p.x, -100000, 100000) && numeroTra(p.y, -100000, 100000) && p.n is int));
    }

    function areaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['autoreUid', 'nome', 'forma', 'misura', 'x', 'y', 'angolo', 'aggiornatoIl'])
        && d.autoreUid == request.auth.uid
        && testoValido(d.nome, 1, 60)
        && d.forma in ['sfera', 'cono', 'cubo', 'linea']
        && numeroTra(d.misura, 1, 150)
        && numeroTra(d.x, -100000, 100000) && numeroTra(d.y, -100000, 100000)
        && numeroTra(d.angolo, -7, 7)
        && d.aggiornatoIl == request.time;
    }

    function testoFacoltativo(d, campo, massimo) {
      return !(campo in d) || d[campo] == null || (d[campo] is string && d[campo].size() <= massimo);
    }

    function listaFacoltativa(d, campo, massimo) {
      return !(campo in d) || (d[campo] is list && d[campo].size() <= massimo);
    }

    function statoCreaturaValido(st) {
      return st is map
        && st.keys().hasOnly(['pfAttuali', 'condizioni', 'risorse', 'equip', 'diario'])
        && numeroTra(st.pfAttuali, 0, 100000)
        && condizioniValide(st.condizioni)
        && st.risorse is list && st.risorse.size() <= 20
        && st.equip is list && st.equip.size() <= 60
        && st.diario is list && st.diario.size() <= 50;
    }

    function creaturaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'taglia', 'tipo', 'sottotipo', 'allineamento', 'ca', 'caValore', 'pf', 'dadiPf', 'velocita',
          'car', 'ts', 'abilita', 'vulnerabilita', 'resistenze', 'immunita', 'immunitaCondizioni', 'sensi', 'lingue', 'gs', 'pe',
          'competenza', 'tratti', 'azioni', 'reazioni', 'leggendarie', 'base', 'indole', 'unico', 'note', 'immagineId', 'stato',
          'aggiornatoIl'])
        && testoValido(d.nome, 1, 60)
        && tagliaValida(d.taglia)
        && testoValido(d.tipo, 1, 40)
        && testoValido(d.ca, 1, 120) && numeroTra(d.caValore, 0, 40)
        && numeroTra(d.pf, 1, 10000) && testoValido(d.dadiPf, 1, 30)
        && d.car is list && d.car.size() == 6
        && d.indole in ['ostile', 'neutrale', 'alleata']
        && d.unico is bool
        && testoFacoltativo(d, 'note', 4000)
        && (d.get('immagineId', null) == null || (d.immagineId is string && d.immagineId.size() <= 40))
        && (d.get('base', null) == null || (d.base is string && d.base.size() <= 60))
        && listaFacoltativa(d, 'tratti', 30) && listaFacoltativa(d, 'azioni', 30)
        && listaFacoltativa(d, 'reazioni', 10) && listaFacoltativa(d, 'leggendarie', 10)
        && (d.get('stato', null) == null || statoCreaturaValido(d.stato))
        && d.aggiornatoIl == request.time;
    }

    function tagliaValida(taglia) {
      return taglia in ['minuscola', 'piccola', 'media', 'grande', 'enorme', 'mastodontica'];
    }

    function contenutoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titolo', 'descrizione', 'categoria', 'larghezza', 'altezza', 'caricataIl',
          'mostrataA', 'vistaDa', 'archiviataPer', 'inTavolaPer', 'visibileA', 'sessioniMostrata'])
        && testoValido(d.titolo, 1, 80)
        && testoOpzionale(d.get('descrizione', null), 500)
        && d.categoria in ['mappa', 'luogo', 'png', 'nemico', 'oggetto', 'dispensa', 'altro']
        && d.larghezza is int && d.altezza is int
        && listaUid(d.mostrataA) && listaUid(d.vistaDa) && listaUid(d.archiviataPer)
        && listaUid(d.get('inTavolaPer', []))
        && d.visibileA is list
        && d.visibileA.toSet() == d.mostrataA.toSet().union(d.archiviataPer.toSet()).union(d.get('inTavolaPer', []).toSet())
        && d.sessioniMostrata is list && d.sessioniMostrata.size() <= 200;
    }

    function contenutoDMValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['note', 'tag', 'archivio', 'sessioniCollegate'])
        && testoOpzionale(d.get('note', null), 2000)
        && d.tag is list && d.tag.size() <= 20
        && d.archivio is bool
        && d.sessioniCollegate is list && d.sessioniCollegate.size() <= 200;
    }

    function statoCombattimentoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['attivo', 'round', 'turno', 'avviatoIl'])
        && d.attivo is bool
        && d.round is int && d.round >= 0 && d.round <= 1000
        && (d.turno == null || (d.turno is string && d.turno.size() <= 40));
    }

    function interoTra(valore, minimo, massimo) {
      return valore is int && valore >= minimo && valore <= massimo;
    }

    function combattenteValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nome', 'uid', 'iniziativa', 'bonus', 'spareggio', 'salute', 'immagineId',
          'condizioni', 'taglia', 'alleato', 'pf', 'creatoIl'])
        && condizioniValide(d.get('condizioni', []))
        && d.get('alleato', false) is bool
        && (d.get('pf', null) == null || (d.pf is map && d.pf.keys().hasOnly(['attuali', 'massimi'])
          && interoTra(d.pf.attuali, -999, 9999) && interoTra(d.pf.massimi, 0, 9999)))
        && tagliaValida(d.get('taglia', 'media'))
        && d.tipo in ['pg', 'nemico']
        && testoValido(d.nome, 1, 60)
        && (d.tipo == 'nemico' || d.uid is string)
        && (d.get('iniziativa', null) == null || interoTra(d.iniziativa, -20, 99))
        && interoTra(d.get('bonus', 0), -20, 30)
        && interoTra(d.get('spareggio', 0), -1000, 1000)
        && d.get('salute', null) in [null, 'illeso', 'ferito', 'grave', 'a terra']
        && (d.get('immagineId', null) == null || (d.immagineId is string && d.immagineId.size() <= 40));
    }

    function combattenteDMValido() {
      let d = request.resource.data;
      let creatura = d.get('creatura', null);
      return d.keys().hasOnly(['pfAttuali', 'pfMassimi', 'note', 'creatura'])
        && (creatura == null || (creatura is map && creatura.keys().hasOnly(['fonte', 'id'])
          && creatura.fonte in ['srd', 'dm'] && creatura.id is string && creatura.id.size() <= 60))
        && interoTra(d.pfAttuali, -999, 9999)
        && interoTra(d.pfMassimi, 0, 9999)
        && testoOpzionale(d.get('note', null), 500);
    }

    // Il riepilogo deve coincidere con il profilo e con la scheda attiva vera.
    function riepilogoValido(campagnaId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nomeGiocatore', 'schedaId', 'nomePersonaggio', 'classe', 'livello', 'hp', 'ritratto',
          'condizioni', 'esaurimento', 'dadiVitaSpesi', 'usiPrivilegi', 'carisma', 'aggiornatoIl'])
        && d.nomeGiocatore == get(percorsoUtente(uid)).data.get('nome', null)
        && d.aggiornatoIl == request.time
        && (d.schedaId == null
          ? (d.nomePersonaggio == null && d.classe == null && d.livello == null && d.hp == null
              && d.get('ritratto', null) == null
              && d.get('condizioni', []) == [] && d.get('esaurimento', 0) == 0 && d.get('dadiVitaSpesi', 0) == 0
              && d.get('usiPrivilegi', {}) == {} && d.get('carisma', null) == null)
          : riepilogoCoincideConScheda(campagnaId, uid, d));
    }

    function riepilogoCoincideConScheda(campagnaId, uid, d) {
      let scheda = getAfter(/databases/$(database)/documents/personaggi/$(d.schedaId)).data;
      return scheda.proprietarioUid == uid
        && scheda.get('campagnaId', null) == campagnaId
        && scheda.get('attiva', false) == true
        && d.nomePersonaggio == scheda.get('nome', null)
        && d.classe == scheda.get('classe', null)
        && d.livello == scheda.get('livello', null)
        && d.hp == scheda.get('hp', null)
        && d.get('ritratto', null) == scheda.get('ritratto', null)
        && d.get('condizioni', []) == scheda.get('condizioni', [])
        && d.get('esaurimento', 0) == scheda.get('esaurimento', 0)
        && d.get('dadiVitaSpesi', 0) == scheda.get('dadiVitaSpesi', 0)
        && d.get('usiPrivilegi', {}) == scheda.get('usiPrivilegi', {})
        && d.get('carisma', null) == scheda.get('caratteristiche', {}).get('carisma', null);
    }

    // Condizioni di 5a edizione (l'esaurimento ha un campo a parte, 0–6).
    function condizioniValide(lista) {
      return lista is list && lista.size() <= 14
        && lista.hasOnly(['accecato', 'affascinato', 'afferrato', 'assordato', 'avvelenato', 'incapacitato',
          'invisibile', 'paralizzato', 'pietrificato', 'privo-di-sensi', 'prono', 'spaventato', 'stordito',
          'trattenuto']);
    }

    // Vecchia collezione pre-campagne: solo lettura per admin/DM (migrazione).
    match /campagna/{docId} {
      allow get: if isDMoAdmin();
    }

    // ---------- Registro sessioni ----------

    match /registroSessioni/{sessioneId} {
      // Lettura: DM e membri della campagna della sessione. DM e admin le
      // leggono tutte finché serve la migrazione pre-campagne (scorre tutte le
      // sessioni per trovare quelle senza campagna): da togliere con essa.
      allow get, list: if isDMoAdmin() || isNellaCampagna(resource.data.get('campagnaId', 'nessuna'));

      // Solo il DM della campagna della sessione (le sessioni di prima delle
      // campagne ricevono la loro con la migrazione).
      allow create: if isDMdellaCampagna(request.resource.data.get('campagnaId', 'nessuna'));
      allow update: if isDMdellaCampagna(resource.data.get('campagnaId', request.resource.data.get('campagnaId', 'nessuna')));
      // Il DM della campagna può eliminare anche le sessioni già giocate (es.
      // quelle di prova): appunti e tiri si eliminano a parte, qui sotto.
      allow delete: if isAdmin()
        || isDMdellaCampagna(resource.data.get('campagnaId', 'nessuna'));

      match /appunti/{appuntoId} {
        allow get, list: if isDMoAdmin() || isNellaCampagnaDellaSessione(sessioneId);

        allow create: if isNellaCampagnaDellaSessione(sessioneId)
          && request.resource.data.keys().hasOnly(['autoreUid', 'autoreNome', 'testo', 'tipo', 'tiro', 'creatoIl'])
          && request.resource.data.get('tipo', null) in [null, 'riposo', 'tiro']
          && tiroValido(request.resource.data)
          && request.resource.data.autoreUid == request.auth.uid
          && request.resource.data.autoreNome == profiloCorrente().get('nome', null)
          && testoValido(request.resource.data.testo, 1, 2000)
          && request.resource.data.creatoIl == request.time
          && get(/databases/$(database)/documents/registroSessioni/$(sessioneId)).data.get('stato', 'in-corso') == "in-corso";

        // Nessuna modifica; eliminazione solo per moderazione del DM.
        allow delete: if isDMdellaSessione(sessioneId);
      }

      // Tiri nascosti del DM: visibili solo al DM della campagna.
      match /tiriNascosti/{tiroId} {
        allow get, list, delete: if isDMdellaSessione(sessioneId);
        allow create: if isDMdellaSessione(sessioneId)
          && request.resource.data.keys().hasOnly(['autoreUid', 'autoreNome', 'testo', 'tipo', 'tiro', 'creatoIl'])
          && request.resource.data.autoreUid == request.auth.uid
          && testoValido(request.resource.data.testo, 1, 2000)
          && request.resource.data.tipo == 'tiro'
          && tiroValido(request.resource.data)
          && request.resource.data.creatoIl == request.time;
      }
    }

    // DM o membro della campagna a cui appartiene la sessione.
    function isNellaCampagnaDellaSessione(sessioneId) {
      return isNellaCampagna(get(/databases/$(database)/documents/registroSessioni/$(sessioneId)).data.get('campagnaId', 'nessuna'));
    }

    function isDMdellaSessione(sessioneId) {
      return isDMdellaCampagna(get(/databases/$(database)/documents/registroSessioni/$(sessioneId)).data.get('campagnaId', 'nessuna'));
    }

    // Dettagli di un tiro di dadi negli appunti (solo per tipo "tiro").
    function tiroValido(d) {
      return !('tiro' in d) || (d.get('tipo', null) == 'tiro' && d.tiro is map && d.tiro.size() <= 10);
    }
  }
}
