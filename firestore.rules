rules_version = '2';

// Regole di sicurezza Firestore per Sotterranei e Dragoni.
// Da incollare in: Console Firebase > Firestore Database > Regole (oppure
// pubblicabili con "firebase deploy --only firestore:rules", vedi firebase.json).
// I test automatici di queste regole sono in test/regole (vedi il README lì).
//
// Premessa: la configurazione Firebase è pubblica (il repo è pubblico), quindi
// chiunque può parlare direttamente con il database saltando le pagine del sito.
// I controlli nel JavaScript delle pagine sono solo interfaccia: la sicurezza
// vera è tutta qui.
//
// Logica:
// - Registrazione aperta, ma con APPROVAZIONE: chi si registra crea il proprio
//   documento in "users" sempre come "player", livello 1, "approvato: false".
//   Finché l'admin non lo approva (e finché l'email non è verificata) può
//   leggere solo il proprio profilo: nessun altro dato della campagna.
//   I profili creati prima dell'introduzione dell'approvazione (senza il campo
//   "approvato") valgono come approvati.
// - Il proprietario di un profilo può modificare solo pochi campi tecnici
//   (email sincronizzata, flag di verifica, ordine dei pannelli) e può SOLO
//   consumare (-1) un credito "livelliDaSpendere", mai aggiungerne.
// - Solo un admin può modificare ruolo/approvazione/dati di un altro utente o
//   eliminare un account. Un DM può solo segnalare un passaggio di livello
//   (+1 a "livello" e "livelliDaSpendere") di un giocatore.
// - Profili utente (con le email) leggibili solo dal proprietario, dal DM e
//   dall'admin: i giocatori vedono gli altri solo tramite il riepilogo del
//   party (vedi "campagne/{id}/party").
// - "users/{uid}/notifiche": leggibili dal destinatario (o admin), create da
//   admin o da un DM verso un giocatore, segnabili come lette dal destinatario.
// - "personaggi/{schedaId}": una scheda per documento, con "proprietarioUid" e
//   "campagnaId" (entrambi immutabili dopo la creazione). Sono ammessi solo i
//   campi noti di una scheda, con tipo e dimensione controllati. Leggibile per intero
//   solo dal proprietario, dal DM e dall'admin. Il livello di una scheda può
//   salire solo di 1 e solo spendendo, nella STESSA scrittura atomica, un
//   credito "livelliDaSpendere" del proprietario (concesso dal DM).
// - "campagne/{campagnaId}": DM proprietario ("dmUid", immutabile per il DM) e
//   membri ("membriUid"). Leggibile solo da DM, membri e admin. Se il titolo è
//   provvisorio, il campo pubblico "titolo" deve essere null: il titolo vero
//   vive in "campagne/{id}/privato/titolo", leggibile solo dal DM e dall'admin.
//   - "stato/{sessione|musica}": stato condiviso in tempo reale (lettura:
//     DM/membri/admin; scrittura: DM/admin).
//   - "party/{uid}": riepilogo pubblico della scheda attiva di ogni membro
//     (nome giocatore, personaggio, classe, livello, PF, versione del
//     ritratto). Le regole verificano che coincida con la scheda vera, quindi
//     non può essere falsificato.
//   - "immagini/{id}": titolo e visibilità delle immagini caricate dal DM
//     (nascosta, visibile a tutti i membri o solo ad alcuni).
// - "campagna/{docId}" (vecchio, pre-campagne): solo lettura per admin/DM, per
//   la migrazione una tantum. Rimovibile a migrazione confermata.
// - "registroSessioni/{sessioneId}": sessioni (programmata/in-corso/chiusa),
//   leggibili dagli utenti approvati, gestite da admin/DM. Un DM può eliminare
//   solo le sessioni ancora "programmata"; l'admin qualsiasi.
//   - "appunti": log scritto da tutti gli utenti approvati, sempre a proprio
//     nome (nome verificato contro il profilo), max 2000 caratteri, solo
//     mentre la sessione è in corso. Non modificabili; eliminabili solo da
//     DM/admin (moderazione).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funzioni di supporto ----------

    function isAutenticato() {
      return request.auth != null;
    }

    function percorsoUtente(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profiloCorrente() {
      return get(percorsoUtente(request.auth.uid)).data;
    }

    function ruoloUtente(uid) {
      return get(percorsoUtente(uid)).data.ruolo;
    }

    // Utente "del tavolo": autenticato, email verificata, con un profilo, e
    // approvato dall'admin (i profili senza il campo valgono come approvati).
    function isApprovato() {
      return isAutenticato()
        && request.auth.token.email_verified == true
        && exists(percorsoUtente(request.auth.uid))
        && profiloCorrente().get('approvato', true) == true;
    }

    function isAdmin() {
      return isApprovato() && profiloCorrente().ruolo == "admin";
    }

    function isDM() {
      return isApprovato() && profiloCorrente().ruolo == "dm";
    }

    function isDMoAdmin() {
      return isApprovato() && profiloCorrente().ruolo in ["dm", "admin"];
    }

    function campiModificati() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function testoValido(valore, minimo, massimo) {
      return valore is string && valore.size() >= minimo && valore.size() <= massimo;
    }

    function testoOpzionale(valore, massimo) {
      return valore == null || (valore is string && valore.size() <= massimo);
    }

    function datiCampagna(campagnaId) {
      return get(/databases/$(database)/documents/campagne/$(campagnaId)).data;
    }

    function datiCampagnaDopo(campagnaId) {
      return getAfter(/databases/$(database)/documents/campagne/$(campagnaId)).data;
    }

    function isDMdellaCampagna(campagnaId) {
      return isAdmin() || (isDM() && datiCampagna(campagnaId).dmUid == request.auth.uid);
    }

    function isNellaCampagna(campagnaId) {
      return isAdmin() || (isApprovato() && (
        datiCampagna(campagnaId).dmUid == request.auth.uid ||
        request.auth.uid in datiCampagna(campagnaId).membriUid
      ));
    }

    // ---------- Utenti ----------

    match /users/{uid} {
      allow get: if isAutenticato() && (request.auth.uid == uid || isDMoAdmin());

      // Elenco: solo admin (pannello utenti) e DM (gestione membri/party).
      allow list: if isDMoAdmin();

      // Creazione: solo il proprio documento, sempre come giocatore in attesa di
      // approvazione — nessuno può registrarsi direttamente come admin/DM.
      allow create: if isAutenticato() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['nome', 'email', 'ruolo', 'livello', 'livelliDaSpendere', 'emailVerificata', 'approvato', 'creatoIl'])
        && testoValido(request.resource.data.nome, 1, 60)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ruolo == "player"
        && request.resource.data.livello == 1
        && request.resource.data.livelliDaSpendere == 0
        && request.resource.data.emailVerificata == false
        && request.resource.data.approvato == false
        && request.resource.data.creatoIl == request.time;

      allow update: if isAutenticato() && (
        (request.auth.uid == uid && aggiornamentoProprioProfiloValido()) ||
        isAdmin() ||
        (isDM() && resource.data.ruolo == "player" && passaggioLivelloDM())
      );

      allow delete: if isAdmin();

      function aggiornamentoProprioProfiloValido() {
        let campi = campiModificati();
        let dati = request.resource.data;
        return campi.hasOnly(['email', 'emailVerificata', 'ordinePannelli', 'livelliDaSpendere'])
          && (!campi.hasAny(['email']) || dati.email == request.auth.token.email)
          && (!campi.hasAny(['emailVerificata']) ||
              (dati.emailVerificata == true && request.auth.token.email_verified == true))
          && (!campi.hasAny(['ordinePannelli']) || dati.ordinePannelli is map)
          && (!campi.hasAny(['livelliDaSpendere']) ||
              (resource.data.livelliDaSpendere >= 1
                && dati.livelliDaSpendere == resource.data.livelliDaSpendere - 1));
      }

      // Il DM segnala un passaggio di livello: +1 a entrambi i contatori, nient'altro.
      function passaggioLivelloDM() {
        return campiModificati().hasOnly(['livello', 'livelliDaSpendere'])
          && request.resource.data.livello == resource.data.get('livello', 0) + 1
          && request.resource.data.livelliDaSpendere == resource.data.get('livelliDaSpendere', 0) + 1;
      }

      match /notifiche/{notificaId} {
        allow read: if isAutenticato() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin() || (isDM() && ruoloUtente(uid) == "player");
        allow update: if isAutenticato() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta']);
        allow delete: if isAdmin();
      }
    }

    // ---------- Schede personaggio ----------

    match /personaggi/{schedaId} {
      allow get: if isApprovato() && (request.auth.uid == resource.data.proprietarioUid || isDMoAdmin());
      allow list: if isDMoAdmin() || (isApprovato() && request.auth.uid == resource.data.proprietarioUid);

      // Creazione: solo a proprio nome, a livello 1, in una campagna di cui si
      // fa parte (come membro o come DM).
      allow create: if isApprovato()
        && request.resource.data.proprietarioUid == request.auth.uid
        && request.resource.data.livello == 1
        && isNellaCampagna(request.resource.data.campagnaId)
        && campiSchedaValidi(request.resource.data.keys());

      allow update: if isAdmin()
        || (isApprovato() && request.auth.uid == resource.data.proprietarioUid && aggiornamentoSchedaValido())
        // Migrazione dei dati pre-campagne: il DM può solo ASSEGNARE una
        // campagna a una scheda che non ne ha ancora una.
        || (isDM() && campiModificati().hasOnly(['campagnaId']) && !('campagnaId' in resource.data));

      allow delete: if isAdmin() || (isApprovato() && request.auth.uid == resource.data.proprietarioUid);

      function aggiornamentoSchedaValido() {
        let campi = campiModificati();
        return !campi.hasAny(['proprietarioUid', 'campagnaId', 'creataIl'])
          && campiSchedaValidi(campi)
          && (!campi.hasAny(['livello']) || passaggioLivelloGiocatore());
      }

      // Solo i campi noti di una scheda, ciascuno col tipo giusto e una
      // dimensione ragionevole (niente campi arbitrari né testi enormi). Si
      // controllano solo i campi scritti in questa operazione ("campi"), così
      // eventuali campi di schede molto vecchie non bloccano gli aggiornamenti.
      function campiSchedaValidi(campi) {
        let d = request.resource.data;
        return campi.hasOnly([
            'nome', 'razza', 'sottorazza', 'classe', 'livello', 'caratteristiche', 'hp', 'tiriSalvezzaMorte',
            'proprietarioUid', 'campagnaId', 'attiva', 'ordine', 'creataIl', 'aggiornatoIl',
            'inventario', 'allineamento', 'background', 'incantesimiConosciuti', 'incantesimiPreparati',
            'slotIncantesimoUsati', 'incantesimiRazzaUsati', 'armaturaIndossata', 'scudoIndossato',
            'abilitaCompetenti', 'personalita', 'competenzeLinguaggi', 'talenti', 'monete', 'ritratto'])
          && (!campi.hasAny(['nome']) || testoValido(d.nome, 1, 60))
          && (!campi.hasAny(['razza']) || testoOpzionale(d.razza, 40))
          && (!campi.hasAny(['sottorazza']) || testoOpzionale(d.sottorazza, 40))
          && (!campi.hasAny(['classe']) || testoOpzionale(d.classe, 40))
          && (!campi.hasAny(['livello']) || (d.livello is int && d.livello >= 1 && d.livello <= 20))
          && (!campi.hasAny(['caratteristiche']) || (d.caratteristiche is map && d.caratteristiche.keys().hasOnly(
              ['forza', 'destrezza', 'costituzione', 'intelligenza', 'saggezza', 'carisma'])))
          && (!campi.hasAny(['hp']) || (d.hp is map && d.hp.keys().hasOnly(['massimi', 'attuali', 'temporanei'])))
          && (!campi.hasAny(['tiriSalvezzaMorte']) || (d.tiriSalvezzaMorte is map
              && d.tiriSalvezzaMorte.keys().hasOnly(['successi', 'fallimenti'])))
          && (!campi.hasAny(['attiva']) || d.attiva is bool)
          && (!campi.hasAny(['ordine']) || (d.ordine is int && d.ordine >= 0 && d.ordine < 1000))
          && (!campi.hasAny(['inventario']) || (d.inventario is list && d.inventario.size() <= 200))
          && (!campi.hasAny(['allineamento']) || testoOpzionale(d.allineamento, 40))
          && (!campi.hasAny(['background']) || testoOpzionale(d.background, 100))
          && (!campi.hasAny(['incantesimiConosciuti']) || (d.incantesimiConosciuti is list && d.incantesimiConosciuti.size() <= 300))
          && (!campi.hasAny(['incantesimiPreparati']) || (d.incantesimiPreparati is list && d.incantesimiPreparati.size() <= 300))
          && (!campi.hasAny(['incantesimiRazzaUsati']) || (d.incantesimiRazzaUsati is list && d.incantesimiRazzaUsati.size() <= 50))
          && (!campi.hasAny(['slotIncantesimoUsati']) || (d.slotIncantesimoUsati is map && d.slotIncantesimoUsati.size() <= 12))
          && (!campi.hasAny(['armaturaIndossata']) || testoOpzionale(d.armaturaIndossata, 60))
          && (!campi.hasAny(['scudoIndossato']) || d.scudoIndossato is bool)
          && (!campi.hasAny(['abilitaCompetenti']) || (d.abilitaCompetenti is list && d.abilitaCompetenti.size() <= 30))
          && (!campi.hasAny(['personalita']) || personalitaValida(d.personalita))
          && (!campi.hasAny(['competenzeLinguaggi']) || testoOpzionale(d.competenzeLinguaggi, 2000))
          && (!campi.hasAny(['talenti']) || (d.talenti is list && d.talenti.size() <= 100))
          && (!campi.hasAny(['ritratto']) || d.ritratto == null || (d.ritratto is int && d.ritratto > 0))
          && (!campi.hasAny(['monete']) || (d.monete is map
              && d.monete.keys().hasOnly(['rame', 'argento', 'elettro', 'oro', 'platino'])));
      }

      function personalitaValida(p) {
        return p is map && p.keys().hasOnly(['tratti', 'ideali', 'legami', 'difetti'])
          && testoOpzionale(p.get('tratti', null), 2000)
          && testoOpzionale(p.get('ideali', null), 2000)
          && testoOpzionale(p.get('legami', null), 2000)
          && testoOpzionale(p.get('difetti', null), 2000);
      }

      // +1 livello solo consumando, nella stessa scrittura atomica (batch), un
      // credito "livelliDaSpendere" del proprietario.
      function passaggioLivelloGiocatore() {
        let utente = percorsoUtente(request.auth.uid);
        return request.resource.data.livello == resource.data.get('livello', 1) + 1
          && getAfter(utente).data.livelliDaSpendere == get(utente).data.livelliDaSpendere - 1;
      }
    }

    // ---------- Campagne ----------

    // Titolo provvisorio => il campo pubblico "titolo" deve restare vuoto.
    function titoloPubblicoCoerente() {
      return request.resource.data.get('titoloProvvisorio', false) != true
        || request.resource.data.get('titolo', null) == null;
    }

    match /campagne/{campagnaId} {
      allow get, list: if isAdmin() || (isApprovato() && (
        resource.data.dmUid == request.auth.uid || request.auth.uid in resource.data.membriUid
      ));

      allow create: if titoloPubblicoCoerente() && (
        isAdmin() || (isDM() && request.resource.data.dmUid == request.auth.uid)
      );

      allow update: if titoloPubblicoCoerente() && (
        isAdmin() || (
          isDM() && resource.data.dmUid == request.auth.uid
          && request.resource.data.dmUid == resource.data.dmUid
        )
      );

      allow delete: if isAdmin();

      match /stato/{docId} {
        allow get: if isNellaCampagna(campagnaId);
        allow write: if isDMdellaCampagna(campagnaId);
      }

      // Titolo vero della campagna (anche quando è ancora provvisorio).
      match /privato/{docId} {
        allow get: if isDMdellaCampagna(campagnaId);
        // getAfter: la campagna può nascere nella stessa scrittura atomica.
        allow write: if isAdmin() || (isDM() && datiCampagnaDopo(campagnaId).dmUid == request.auth.uid);
      }

      // Immagini della campagna (PNG, luoghi, mappe, dispense): il file è in
      // Storage (campagne/{campagnaId}/{immagineId}), qui titolo e visibilità.
      // Il DM le vede tutte; un membro solo quelle rese visibili a tutti o a
      // lui in particolare. Le stesse condizioni valgono per i file (storage.rules).
      match /immagini/{immagineId} {
        allow get, list: if isDMdellaCampagna(campagnaId) || (
          isApprovato()
          && request.auth.uid in datiCampagna(campagnaId).membriUid
          && (resource.data.visibilita == "tutti"
            || (resource.data.visibilita == "selezionati" && request.auth.uid in resource.data.lettori))
        );
        allow create, update: if isDMdellaCampagna(campagnaId) && immagineCampagnaValida();
        allow delete: if isDMdellaCampagna(campagnaId);
      }

      // Riepilogo pubblico della scheda attiva di un membro.
      match /party/{uid} {
        allow get, list: if isNellaCampagna(campagnaId);

        allow create, update: if riepilogoValido(campagnaId, uid) && (
          isDMdellaCampagna(campagnaId) ||
          (isApprovato() && request.auth.uid == uid && uid in datiCampagna(campagnaId).membriUid)
        );

        allow delete: if isDMdellaCampagna(campagnaId);
      }
    }

    function immagineCampagnaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titolo', 'descrizione', 'categoria', 'visibilita', 'lettori', 'larghezza', 'altezza', 'caricataIl'])
        && testoValido(d.titolo, 1, 80)
        && testoOpzionale(d.get('descrizione', null), 500)
        && d.categoria in ['png', 'luogo', 'mappa', 'oggetto', 'dispensa', 'altro']
        && d.visibilita in ['dm', 'tutti', 'selezionati']
        && d.lettori is list && d.lettori.size() <= 30
        && d.larghezza is int && d.altezza is int;
    }

    // Il riepilogo deve coincidere con il profilo e con la scheda attiva vera.
    function riepilogoValido(campagnaId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nomeGiocatore', 'schedaId', 'nomePersonaggio', 'classe', 'livello', 'hp', 'ritratto', 'aggiornatoIl'])
        && d.nomeGiocatore == get(percorsoUtente(uid)).data.get('nome', null)
        && d.aggiornatoIl == request.time
        && (d.schedaId == null
          ? (d.nomePersonaggio == null && d.classe == null && d.livello == null && d.hp == null
              && d.get('ritratto', null) == null)
          : riepilogoCoincideConScheda(campagnaId, uid, d));
    }

    function riepilogoCoincideConScheda(campagnaId, uid, d) {
      let scheda = getAfter(/databases/$(database)/documents/personaggi/$(d.schedaId)).data;
      return scheda.proprietarioUid == uid
        && scheda.get('campagnaId', null) == campagnaId
        && scheda.get('attiva', false) == true
        && d.nomePersonaggio == scheda.get('nome', null)
        && d.classe == scheda.get('classe', null)
        && d.livello == scheda.get('livello', null)
        && d.hp == scheda.get('hp', null)
        && d.get('ritratto', null) == scheda.get('ritratto', null);
    }

    // Vecchia collezione pre-campagne: solo lettura per admin/DM (migrazione).
    match /campagna/{docId} {
      allow get: if isDMoAdmin();
    }

    // ---------- Registro sessioni ----------

    match /registroSessioni/{sessioneId} {
      allow get, list: if isApprovato();

      allow create, update: if isDMoAdmin();
      allow delete: if isAdmin() || (isDM() && resource.data.get('stato', null) == "programmata");

      match /appunti/{appuntoId} {
        allow get, list: if isApprovato();

        allow create: if isApprovato()
          && request.resource.data.keys().hasOnly(['autoreUid', 'autoreNome', 'testo', 'creatoIl'])
          && request.resource.data.autoreUid == request.auth.uid
          && request.resource.data.autoreNome == profiloCorrente().get('nome', null)
          && testoValido(request.resource.data.testo, 1, 2000)
          && request.resource.data.creatoIl == request.time
          && get(/databases/$(database)/documents/registroSessioni/$(sessioneId)).data.get('stato', 'in-corso') == "in-corso";

        // Nessuna modifica; eliminazione solo per moderazione.
        allow delete: if isDMoAdmin();
      }
    }
  }
}
