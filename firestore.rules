rules_version = '2';

// Regole di sicurezza Firestore per Sotterranei e Dragoni.
// Da incollare in: Console Firebase > Firestore Database > Regole.
//
// Logica:
// - Ogni utente autenticato può leggere e creare il PROPRIO documento in "users"
//   (creato automaticamente in fase di registrazione), ma NON può modificare
//   il proprio campo "ruolo" né "livello" (per evitare di auto-promuoversi o
//   auto-livellarsi).
// - Solo un admin può modificare ruolo/dati di un altro utente, oppure
//   eliminare un account.
// - Solo un admin può elencare TUTTI gli utenti (pannello di gestione utenti).
//   Chiunque sia autenticato può invece elencare SOLO i documenti con ruolo
//   "player" (roster del party, visibile a tutti nella pagina Sessione).
// - Un DM può aggiornare esclusivamente i campi legati al livello di un
//   giocatore ("livello", "livelliDaSpendere"), non altro.
// - Ogni utente ha una sotto-collezione "notifiche": solo il proprietario (o un
//   admin) può leggerla; solo il proprietario può segnarle come lette; solo un
//   admin o un DM (verso un giocatore) può crearne di nuove.
// - Collezione "personaggi/{schedaId}": ogni documento è UNA scheda personaggio,
//   con un campo "proprietarioUid" che indica di chi è. Un utente può avere più
//   schede (più personaggi), ognuna col proprio flag "attiva" (una sola alla
//   volta per utente, imposto lato client). Il proprietario può leggere e
//   scrivere le proprie schede; un admin o un DM possono sempre solo leggerle;
//   chiunque sia autenticato può leggere una scheda ALTRUI se è quella attiva
//   (il party è "trasparente" tra i giocatori nella pagina Sessione), non le
//   schede non attive di altri.
// - Documenti singoli nella collezione "campagna" (es. "sessione", "musica"):
//   stato condiviso scrivibile solo da admin/DM e leggibile da chiunque sia
//   autenticato — regola generica per {docId}, unica per tutti i documenti di
//   questa collezione. "sessione" = interruttore manuale + riferimento alla
//   voce di registro aperta. "musica" = sorgente audio trasmessa ai giocatori
//   (Spotify/YouTube) e relativo snapshot (brano/artista/copertina), scritto
//   dal browser del DM.
// - Collezione "registroSessioni/{sessioneId}": una voce per ogni sessione
//   giocata (numero progressivo, data di apertura/chiusura), creata e chiusa
//   solo da admin/DM. Sotto-collezione "appunti": il registro vero e proprio,
//   in cui chiunque sia autenticato (DM e giocatori) può scrivere una nuova
//   riga a proprio nome; è un log di sola aggiunta, nessuno può modificarlo o
//   cancellarlo dopo averlo scritto.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAutenticato() {
      return request.auth != null;
    }

    function ruoloUtente(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.ruolo;
    }

    function isAdmin() {
      return isAutenticato() && ruoloUtente(request.auth.uid) == "admin";
    }

    function isDM() {
      return isAutenticato() && ruoloUtente(request.auth.uid) == "dm";
    }

    function soloCampiLivello() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['livello', 'livelliDaSpendere']);
    }

    match /users/{uid} {
      // Lettura di un singolo documento: il proprietario o un admin.
      allow get: if isAutenticato() && (request.auth.uid == uid || isAdmin());

      // Elenco dell'intera collezione (pannello utenti): solo admin.
      // Chiunque sia autenticato può invece elencare i soli documenti con
      // ruolo "player" (roster del party nella pagina Sessione): la query
      // lato client deve filtrare esplicitamente su ruolo == "player".
      allow list: if isAdmin() || (isAutenticato() && resource.data.ruolo == "player");

      // Creazione: solo il proprio documento, in fase di registrazione.
      allow create: if isAutenticato() && request.auth.uid == uid;

      // Aggiornamento:
      // - il proprietario può modificare tutto TRANNE "ruolo" e "livello";
      // - un admin può modificare qualunque campo di chiunque;
      // - un DM può modificare SOLO i campi legati al livello di un giocatore.
      allow update: if isAutenticato() && (
        (request.auth.uid == uid
          && request.resource.data.ruolo == resource.data.ruolo
          && request.resource.data.livello == resource.data.livello) ||
        isAdmin() ||
        (isDM() && resource.data.ruolo == "player" && soloCampiLivello())
      );

      allow delete: if isAdmin();

      match /notifiche/{notificaId} {
        // Lettura: solo il destinatario o un admin.
        allow read: if isAutenticato() && (request.auth.uid == uid || isAdmin());

        // Creazione: un admin, oppure un DM verso un giocatore.
        allow create: if isAdmin() || (isDM() && ruoloUtente(uid) == "player");

        // Aggiornamento: solo il destinatario, e solo per segnarla come letta.
        allow update: if isAutenticato() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta']);

        allow delete: if isAdmin();
      }
    }

    match /personaggi/{schedaId} {
      // Lettura di una scheda: il proprietario, un admin, un DM, oppure
      // chiunque sia autenticato se la scheda è quella ATTIVA (party trasparente
      // nella pagina Sessione — le schede non attive di altri restano private).
      allow get: if isAutenticato() && (
        request.auth.uid == resource.data.proprietarioUid || isAdmin() || isDM() || resource.data.attiva == true
      );

      // Elenco: il proprietario può elencare le PROPRIE schede (query filtrata su
      // proprietarioUid lato client); admin/DM possono elencare quelle di chiunque
      // (es. per trovare la scheda attiva di un giocatore); chiunque sia
      // autenticato può elencare le schede ATTIVE di chiunque (roster del party).
      allow list: if isAdmin() || isDM() || (
        isAutenticato() && (request.auth.uid == resource.data.proprietarioUid || resource.data.attiva == true)
      );

      // Creazione: solo a proprio nome.
      allow create: if isAutenticato() && request.resource.data.proprietarioUid == request.auth.uid;

      // Aggiornamento/eliminazione: solo il proprietario della scheda, o un admin.
      allow update: if isAutenticato() && (request.auth.uid == resource.data.proprietarioUid || isAdmin());
      allow delete: if isAutenticato() && (request.auth.uid == resource.data.proprietarioUid || isAdmin());
    }

    match /campagna/{docId} {
      // Lettura: chiunque sia autenticato (serve a tutti i giocatori per sapere
      // se una sessione è in corso).
      allow get: if isAutenticato();

      // Scrittura: solo admin o DM (apertura/chiusura della sessione).
      allow write: if isAdmin() || isDM();
    }

    match /registroSessioni/{sessioneId} {
      // Lettura: chiunque sia autenticato (storico consultabile da tutti).
      allow get: if isAutenticato();
      allow list: if isAutenticato();

      // Apertura/chiusura di una sessione: solo admin/DM.
      allow create: if isAdmin() || isDM();
      allow update: if isAdmin() || isDM();
      allow delete: if isAdmin();

      match /appunti/{appuntoId} {
        // Lettura: chiunque sia autenticato.
        allow get: if isAutenticato();
        allow list: if isAutenticato();

        // Creazione: chiunque sia autenticato, solo a proprio nome (autoreUid
        // deve coincidere con chi scrive). Nessun update/delete: è un log di
        // sola aggiunta, non modificabile dopo la scrittura.
        allow create: if isAutenticato() && request.resource.data.autoreUid == request.auth.uid;
      }
    }
  }
}
